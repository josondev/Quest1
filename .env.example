# ==========================================
# OCR Engine (Tier 2/3)
# ==========================================
MISTRAL_API_KEY=your_mistral_api_key_here

# ==========================================
# Speech-to-Text STT (Tier 1)
# Recommended: Groq (generous free tier: 8 hrs/day, blazing fast word timestamps)
# Providers: "groq", "huggingface"
# ==========================================
WHISPER_PROVIDER=groq
WHISPER_MODEL_NAME=whisper-large-v3
GROQ_API_KEY=your_groq_api_key_here
HF_TOKEN=your_huggingface_token_here

# ==========================================
# Fallback Vision-Language Model (Tier 4)
# Provider: NVIDIA NIM (meta/llama-3.2-11b-vision-instruct or nvidia/neva-22b)
# Endpoint: https://integrate.api.nvidia.com/v1
# ==========================================
VLM_PROVIDER=nvidia
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_VLM_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ==========================================
# Confidence Fusion Weights & Thresholds
# ==========================================
CONFIDENCE_THRESHOLD=0.85
WEIGHT_SIMILARITY=0.45
WEIGHT_OCR_CONFIDENCE=0.35
WEIGHT_TEMPORAL_ALIGNMENT=0.20

# Search & Sampling Windows
SUBTITLE_SEARCH_PADDING_SECONDS=2.0
SPARSE_OCR_FPS=1.0

# ==========================================
# Storage & Network
# ==========================================
ARTIFACT_STORAGE_DIR=./artifacts
TEMP_STORAGE_DIR=./temp_data
API_HOST=0.0.0.0
API_PORT=8000
